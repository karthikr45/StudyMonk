# =============================================================================
# StudyMonk environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# ---- Database (PostgreSQL) --------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studymonk?schema=public"

# ---- JWT / Auth secrets -----------------------------------------------------
# Generate strong random values, e.g.:  openssl rand -base64 48
# These MUST be different from each other and kept secret.
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"

# Access-token lifetime (seconds). Default 900 = 15 minutes.
ACCESS_TOKEN_TTL="900"
# Refresh-token lifetime (seconds). Default 604800 = 7 days.
REFRESH_TOKEN_TTL="604800"

# ---- API gateway key (Level-1 API security) ---------------------------------
# Every /api request must send header  x-api-key: <this value>.
# This is the client-credential layer that sits in front of user auth.
# Generate with:  openssl rand -hex 32
API_GATEWAY_KEY="change-me-generate-a-long-random-api-key"

# ---- Cloudflare R2 (S3-compatible object storage) ---------------------------
# Add the keys you already have here. R2 is used to store all study content.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="studymonk-content"
# Endpoint is usually https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT="https://your-cloudflare-account-id.r2.cloudflarestorage.com"

# ---- AI provider (optional, open-source) ------------------------------------
# Powers question generation and subjective grading. Leave as "none" to run
# the assessment engine manual-only. Switch on when you're ready — no code
# changes needed.
#   none               → AI disabled
#   ollama             → local Ollama server (free, offline). Install from ollama.com,
#                        then e.g.  ollama pull llama3.1
#   openai_compatible  → any hosted OpenAI-compatible open-model endpoint
AI_PROVIDER="none"
AI_MODEL="llama3.1"
# For AI_PROVIDER=ollama
OLLAMA_URL="http://localhost:11434"
# For AI_PROVIDER=openai_compatible
AI_BASE_URL=""
AI_API_KEY=""

# ---- App ---------------------------------------------------------------------
# Public base URL of the app (used where absolute URLs are needed).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
